TELNYX_WEBHOOK_PUBLIC_KEY=

# Storage (iDrive e2, S3-compatible) -- attachments & media
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_BASE_URL=

# Google Places (server-only — never exposed to the client)
GOOGLE_PLACES_API_KEY=

# MCP server (Telnyx voice assistant + web MCP clients) -- phase 12
# Static bearer key the Telnyx AI assistant uses to call the MCP endpoint
MCP_SERVICE_KEY=
# Clerk OAuth application (OIDC provider for the MCP authorization layer)
MCP_CLERK_OAUTH_CLIENT_ID=
MCP_CLERK_OAUTH_CLIENT_SECRET=
# Clerk instance issuer, e.g. https://<instance>.clerk.accounts.dev (see Clerk dashboard)
MCP_CLERK_OAUTH_ISSUER=
# Canonical public origin of the MCP server (RFC 8707 resource + redirect base)
MCP_PUBLIC_ORIGIN=
# Secret the Telnyx edge function sends to /api/v1/mcp/edge/phone-auth (defaults to INTERNAL_FETCH_SECRET)
MCP_EDGE_SECRET=
# Telnyx Inference model for voicemail summaries / STT (OpenAI-compatible /v2/ai endpoints)
TELNYX_INFERENCE_MODEL=
TELNYX_STT_MODEL=
