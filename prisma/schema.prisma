  replyToMessageId    String?              @db.ObjectId
  threadRootMessageId String?              @db.ObjectId
  deletedAt           DateTime?
  deletedByUserId     String?              @db.ObjectId
  editedAt            DateTime?
  metadata            Json?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([channelId, createdAt])
  @@index([dmConversationId, createdAt])
  @@index([threadRootMessageId, createdAt])
  @@index([authorUserId, createdAt])
}

model ChatInviteLink {
  id               String       @id @default(auto()) @map("_id") @db.ObjectId
  clerkOrgId       String
  token            String       @unique
  createdByUserId  String       @db.ObjectId
  inviteeUserId    String?      @db.ObjectId
  acceptedByUserId String?      @db.ObjectId
  maxUses          Int?
  usedCount        Int          @default(0)
  expiresAt        DateTime?
  status           InviteStatus @default(ACTIVE)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([clerkOrgId, status])
  @@index([inviteeUserId, status])
}

model ChatReadState {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  userId            String   @db.ObjectId
  roomKey           String
  channelId         String?  @db.ObjectId
  dmConversationId  String?  @db.ObjectId
  lastReadMessageId String?  @db.ObjectId
  lastReadAt        DateTime?
  updatedAt         DateTime @updatedAt

  @@unique([userId, roomKey])
  @@index([channelId])
  @@index([dmConversationId])
}

model SmsConversation {
  id                     String    @id @default(auto()) @map("_id") @db.ObjectId
  userId                 String    @db.ObjectId
  counterpartPhoneNumber String
  virtualNumberId        String?   @db.ObjectId
  lastMessageAt          DateTime?
  lastReadAt             DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@unique([userId, counterpartPhoneNumber])
  @@index([userId, lastMessageAt])
  @@index([virtualNumberId])
}

model SmsMessage {
  id              String             @id @default(auto()) @map("_id") @db.ObjectId
  conversationId  String             @db.ObjectId
  userId          String             @db.ObjectId
  direction       SmsDirection
  fromPhoneNumber String
  toPhoneNumber   String
  text            String
  status          SmsMessageStatus?
  telnyxMessageId String?            @unique
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([conversationId, createdAt])
  @@index([userId, createdAt])
}

// Voicemail left by a phone caller for a Dupip user (Telnyx AI assistant voice mail).
// Audio lives in iDrive e2 under vm/<targetUserId>/...; transcript/summary are text.
model Voicemail {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Recipient (the Dupip user whose assistant received the message)
  targetUserId String   @db.ObjectId
  targetUser   User     @relation("UserVoicemails", fields: [targetUserId], references: [id], onDelete: Cascade)

  // Caller (known Dupip user when resolvable; phone number otherwise)
  callerUserId   String?
  callerPhone    String?
  callerName     String?
  callerVerified Boolean @default(false) // STIR/SHAKEN A attestation on the inbound call

  // Stored media + AI outputs
  audioKey         String?
  audioMimeType    String?
  audioDurationSec Int?
  transcript       String?
  summary          String?
  source           String   @default("AI_ASSISTANT") // AI_ASSISTANT | RECORDING

  // Telnyx correlation (idempotent re-delivery + recording attachment)
  telnyxConversationId String? @unique
  callSessionId        String?
  callControlId        String?

  // Lazy recording attach throttle (assistant connections have no event
  // webhook, so the recordings API is polled from the client-triggered paths)
  recordingAttemptedAt DateTime?
  recordingAttempts    Int      @default(0)

  readAt DateTime?

  @@index([targetUserId, createdAt])
  @@index([callSessionId])
  @@index([callControlId])
}
