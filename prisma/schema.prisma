// =============================================================================
// PRISMA SCHEMA - MongoDB
// =============================================================================
// Organization: Generator/Datasource → Enums → Types → Models
// =============================================================================

generator client {
  provider      = "prisma-client-js"
  output        = "../generated/prisma"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// =============================================================================
// ENUMS
// =============================================================================

enum Areas {
  self
  home
  social
  work
}

enum Category {
  body
  spirituality
  fun
  extra
  clean
  affection
  maintenance
  community
  growth
  work
  mind
  spirit
  social
  home
  custom
  event
}

enum CurrencyCode {
  USD
  EUR
  JPY
  GBP
  CNY
  AUD
  CAD
  CHF
  HKD
  BRL
  SEK
  NZD
  MXN
  SGD
  NOK
  KRW
  TRY
  INR
  RUB
  ZAR
  PLN
  CZK
  HUF
  RON
  BGN
  DKK
  ISK
  RSD
  BAM
  MKD
  ALL
  MDL
  UAH
  BYN
  GEL
  AMD
  AZN
}

enum JobStatus {
  REQUESTED
  IN_PROGRESS
  SUBMITTED
  VALIDATING
  ACCEPTED
  REJECTED
  CANCELLED
}

enum NoteVisibility {
  PRIVATE
  FRIENDS
  CLOSE_FRIENDS
  PUBLIC
  AI_ENABLED
  DOC_ENABLED
}

// How much mood data a delegation grants, on top of the note/day visibility
// scopes: every dimension separately, only the overall average, or none at all.
// Enforced everywhere a delegate sees the delegator's data (phone assistant,
// dashboard charts, in-app agent).
enum MoodScope {
  ALL_DIMENSIONS
  AVERAGE_ONLY
  NONE
}

enum RecurrenceFrequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
  NONE
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  STEADY
  READY
  DONE
  IGNORED
  SKIPPED
  COMPLETED
}

enum UserRole {
  OWNER
  MANAGER
  COLLABORATOR
  FOLLOWER
}

enum Visibility {
  PUBLIC
  PRIVATE
  FRIENDS
  CLOSE_FRIENDS
  HIDDEN
}

enum ChatRole {
  SUPERUSER
  ADMIN
  MODERATOR
  USER
}

enum ChatChannelType {
  TEXT
  ANNOUNCEMENT
}

enum ChatRoomType {
  ORG_CHANNEL
  DIRECT_MESSAGE
}

enum MessageContentFormat {
  PLAIN_TEXT
}

enum InviteStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum SmsDirection {
  INBOUND
  OUTBOUND
}

enum SmsMessageStatus {
  SENT
  DELIVERED
  FAILED
}

// =============================================================================
// EMBEDDED TYPES
// =============================================================================

type Completer {
  id          String    @db.ObjectId
  earnings    Float?
  premium     Float?
  time        Int
  completedAt DateTime
}

type Consents {
  doInvestDemo        DoInvestDemoConsent?
  dpipNoMonetaryValue DoInvestDemoConsent?
}

type Currency {
  code   CurrencyCode?
  symbol String?
}

type DayVisibility {
  lists    Boolean
  mood     Boolean
  ticker   Boolean
  analysis Boolean
}

type DoInvestDemoConsent {
  consentedOn     DateTime
  consentQuestion String
}

type DocumentReference {
  id       String
  fileName String
  fileUrl  String
}

type EmbeddedTask {
  id              String?
  name            String
  cadence         String? //to-do replace with recurrence   
  categories      Category[]
  area            Areas
  status          String
  recurrence      RecurrenceRule?
  nextOccurrence  DateTime?
  lastOccurrence  DateTime?
  firstOccurrence DateTime?
  times           Int?
  count           Int?
  localeKey       String?
  persons         PersonReference[]
  things          ThingReference[]
  events          EventReference[]
  notes           NoteReference[]
  documents       DocumentReference[]
  createdAt       String?
  completedOn     String?
  dueDate         DateTime?
  budget          Float?
  visibility      Visibility?
  quality         Int?
  redacted        Boolean?          @default(false)
  templateId      String?           // Optional reference to original template
}

type EventReference {
  id   String
  name String
}

type ListHistoryEntry {
  year      Int
  date      String // YYYY-MM-DD format
  operation String // e.g., 'completed', 'requested-validation'
  username  String?
  userId    String @db.ObjectId
}

type ListProductivity {
  totalTasks     Int
  completedTasks Int
  percentage     Float
}

type Mood {
  gratitude  Float
  optimism   Float
  restedness Float
  tolerance  Float
  selfEsteem Float
  trust      Float
}

type NoteReference {
  id      String
  content String
}

type PersonReference {
  id   String
  name String
}

type ProfileChartField {
  name       String?
  value      Json?
  visibility Boolean
}

type ProfileMeetMe {
  preferredTime String?
  duration      String?
  availability  String?
  startDate     String?
  endDate       String?
}

type ProfileLinksField {
  value      Json?
  visibility Boolean
}

type ProfileData {
  username       ProfileField?
  firstName      ProfileField?
  lastName       ProfileField?
  bio            ProfileField?
  profilePicture ProfileField?
  charts         ProfileChartField?
  meetMe         ProfileMeetMe?
  links          ProfileLinksField?
}

type ProfileField {
  name       String?
  value      String?
  visibility Boolean
}

type RecurrenceRule {
  frequency       RecurrenceFrequency
  interval        Int                 @default(1)
  byWeekday       Int[]
  byMonthDay      Int[]
  byMonth         Int[]
  endDate         DateTime?
  occurrenceCount Int?
}

type Settings {
  currency             Currency?
  speed                Float?
  dailyPremiumFactor   Int?      @default(30)  // Minimum: 1. Divides premium for daily lists
  weeklyPremiumFactor  Int?      @default(4)   // Minimum: 1. Divides premium for weekly lists
  globalPremiumFactor  Int?      @default(1)   // Minimum: 1. Divides premium in all scenarios
}

type ThingReference {
  id   String
  name String
}

type AllocationType {
  nominal Float?   // Nominal (currency) amount
  percent Float?   // Percentage value (0-100)
}

type EntityBudgetAllocation {
  budget  AllocationType?  // Budget allocation for this entity
  premium AllocationType?  // Premium allocation for this entity
}

type EntityAllocationsType {
  entityId      String?                 // Entity ID (taskId, areaId, categoryId, etc.)
  entityType    String?                 // Entity type: "tasks", "lists", "projects"
  entitySubtype String?                 // Entity subtype: "area", "categories", "notes", or any string
  allocation    EntityBudgetAllocation? // Allocation for this entity
}

type BudgetDistribution {
  areas      EntityAllocationsType[]  // Area allocations (budget + premium)
  categories EntityAllocationsType[]  // Category allocations (budget + premium)
  tasks      EntityAllocationsType[]  // Per-task allocations (budget + premium)
}

type Ticker {
  listId   String?
  taskId   String?
  earnings Float?
  premium  Float?
}

type UserReference {
  userId String   @db.ObjectId
  role   UserRole
}

type JobInvoice {
  quote    Float?  // Original task earnings at job initiation
  premium  Float?  // Premium value at job initiation
  exposure Float?  // totalGains value at job initiation
}

// =============================================================================
// MODELS
// =============================================================================

model User {
  id                 String    @id @default(auto()) @map("_id") @db.ObjectId
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  userId             String?   @unique
  email              String?
  lastLogin          DateTime?
  settings           Settings?
  consents           Consents?
  // Default visibility for new notes (user preference, PRIVATE unless changed)
  defaultNoteVisibility NoteVisibility @default(PRIVATE)
  defaultAiEnabled      Boolean        @default(false)
  // Financial fields
  usedBudget         Float?    @default(0)
  remainingBudget    Float?    @default(100)
  stash              Float?    @default(0)
  profit             Float?    @default(0)
  equity             Float?    @default(0)
  availableBalance   Float?    @default(0)
  withdrawn          Float?    @default(0)
  totalGains         Float?    @default(0)
  // Relations
  persons            Person[]
  things             Thing[]
  events             Event[]       @relation("PublicEvents")
  lifeEvents         LifeEvent[]   @relation("LifeEvents")
  notes              Note[]
  sentNotes          Note[]    @relation("SentNotes")
  receivedNotes      Note[]    @relation("ReceivedNotes")
  comments           Comment[]
  likes              Like[]
  profiles           Profile[]
  charts             Chart[]
  budgets            Budget[]
  days               Day[]
  offers             Offer[]
  tokens             Token[]
  transactions       Transaction[]
  wallets            Wallet[]
  workerJobs         Job[]     @relation("JobWorker")
  // Friend relations (self-referential many-to-many)
  friends            String[]  @default([]) @db.ObjectId
  friendUsers        User[]    @relation("UserFriends", fields: [friends], references: [id])
  friendOfIds        String[]  @default([]) @db.ObjectId
  friendOf           User[]    @relation("UserFriends", fields: [friendOfIds], references: [id])
  closeFriends       String[]  @default([]) @db.ObjectId
  closeFriendUsers   User[]    @relation("UserCloseFriends", fields: [closeFriends], references: [id])
  closeFriendOfIds   String[]  @default([]) @db.ObjectId
  closeFriendOf      User[]    @relation("UserCloseFriends", fields: [closeFriendOfIds], references: [id])
  friendRequests     String[]  @default([]) @db.ObjectId
  friendRequestUsers User[]    @relation("UserFriendRequests", fields: [friendRequests], references: [id])
  friendRequestOfIds String[]  @default([]) @db.ObjectId
  friendRequestOf    User[]    @relation("UserFriendRequests", fields: [friendRequestOfIds], references: [id])
  // Task/Job relations
  candidateTaskIds   String[]  @default([]) @db.ObjectId
  candidateTasks     Task[]    @relation("TaskCandidates", fields: [candidateTaskIds], references: [id])
  reviewerJobIds     String[]  @default([]) @db.ObjectId
  reviewerJobs       Job[]     @relation("JobReviewers", fields: [reviewerJobIds], references: [id])
  documents          Document[] @relation("UserDocuments")
  listRequests       ListRequest[] @relation("ListRequests")
  taskApplications   TaskApplication[] @relation("TaskApplications")
  orgMemberships     OrgMembership[] @relation("OrgMemberships")
  eventRsvps         EventRsvp[]     @relation("EventRsvps")
  eventStaff         EventStaff[]    @relation("EventStaff")
  delegatedAccessGranted Delegation[] @relation("Delegator")
  delegatedAccessReceived Delegation[] @relation("Delegated")
  phoneDelegations   PhoneDelegation[] @relation("PhoneDelegations")
  emailNotifications EmailNotification[]
  virtualNumbers    VirtualNumber[]
  voicemails        Voicemail[] @relation("UserVoicemails")
  notifications     Notification[] @relation("UserNotifications")
}

model VirtualNumber {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  userId             String   @db.ObjectId
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  phoneNumber        String   @unique
  messagingProfileId String?
  provider           String   @default("TELNYX")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([userId])
}

model EmailNotification {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  type            String
  scopeKey        String
  recipientUserId String   @db.ObjectId
  recipientUser   User     @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)
  chatMessageId   String?  @db.ObjectId
  sentAt          DateTime?
  payload         Json?

  @@unique([recipientUserId, scopeKey])
  @@index([recipientUserId, type, sentAt])
  @@index([chatMessageId])
}

// In-app bell notifications. `type` is a structured key the client localizes
// (JOB_REQUESTED, JOB_ACCEPTED, JOB_REJECTED, LIST_INVITE, ...); `message` is an
// optional pre-rendered fallback. `actorId`/`resourceId` are display references,
// deliberately not relations (a deleted actor must not delete the notification).
model Notification {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  // Recipient (internal User id)
  userId     String    @db.ObjectId
  user       User      @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  type       String
  // Internal User id of whoever triggered the notification (optional)
  actorId    String?   @db.ObjectId
  // Related resource id (job, list, note, ...)
  resourceId String?   @db.ObjectId
  message    String?
  readAt     DateTime?

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

model Profile {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  userId      String       @unique @db.ObjectId
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  username    String?      @unique
  visibility  Visibility   @default(PUBLIC)
  data        ProfileData?
  // Reference arrays
  personIds   String[]     @default([]) @db.ObjectId
  persons     Person[]     @relation("PersonProfiles", fields: [personIds], references: [id])
  noteIds     String[]     @default([]) @db.ObjectId
  documentIds String[]     @default([]) @db.ObjectId
  // Back relations
  comments    Comment[]
  charts      Chart[]
  days        Day[]
}

model Day {
  id              String         @id @default(auto()) @map("_id") @db.ObjectId
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  date            String?
  week            Int?
  month           Int?
  quarter         Int?
  semester        Int?
  // Embedded data
  tasks           EmbeddedTask[]
  mood            Mood?
  ticker          Ticker[]
  analysis        Json?
  productivity    Json?
  fieldVisibility DayVisibility?
  // Calculated fields
  average         Float?
  progress        Float?
  balance         Float?
  stash           Float?
  equity          Float?
  withdrawn       Float?
  // Visibility
  visibility      Visibility     @default(PRIVATE)
  // Reference arrays
  personIds       String[]       @default([]) @db.ObjectId
  thingIds        String[]       @default([]) @db.ObjectId
  lifeEventIds    String[]       @default([]) @db.ObjectId   // life events (Phase 8 split)
  chartIds        String[]       @default([]) @db.ObjectId
  noteIds         String[]       @default([]) @db.ObjectId
  commentIds      String[]       @default([]) @db.ObjectId
  likeIds         String[]       @default([]) @db.ObjectId
  // Relations
  userId          String         @db.ObjectId
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  profileId       String?        @db.ObjectId
  profile         Profile?       @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
}

model Note {
  id             String         @id @default(auto()) @map("_id") @db.ObjectId
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  content        String
  date           String?
  visibility     NoteVisibility @default(PRIVATE)
  aiEnabled      Boolean        @default(false)
  // Relations
  userId         String         @db.ObjectId
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  senderId       String?        @db.ObjectId
  sender         User?          @relation("SentNotes", fields: [senderId], references: [id], onDelete: SetNull)
  recipientId    String?        @db.ObjectId
  recipient      User?          @relation("ReceivedNotes", fields: [recipientId], references: [id], onDelete: SetNull)
  comments       Comment[]
  likes          Like[]
  // Reference arrays
  personIds      String[]       @default([]) @db.ObjectId
  thingIds       String[]       @default([]) @db.ObjectId
  lifeEventIds   String[]       @default([]) @db.ObjectId   // life events (Phase 8 split)
  eventIds       String[]       @default([]) @db.ObjectId   // public events (Phase 8): the event's discussion stream
  profileIds     String[]       @default([]) @db.ObjectId
  templateIds    String[]       @default([]) @db.ObjectId
  listIds         String[]       @default([]) @db.ObjectId
  documentIds     String[]       @default([]) @db.ObjectId
  chartIds        String[]       @default([]) @db.ObjectId
  taskIds         String[]       @default([]) @db.ObjectId
  requesterJobIds String[]       @default([]) @db.ObjectId
  requesterJobs   Job[]          @relation("JobRequesterNotes", fields: [requesterJobIds], references: [id])
  reviewerJobIds  String[]       @default([]) @db.ObjectId
  reviewerJobs    Job[]          @relation("JobReviewersNotes", fields: [reviewerJobIds], references: [id])
  // Geolocation
  location        Json?
  // Reposted list (repost = note about a list)
  repostedListId  String?        @db.ObjectId

  @@index([userId])
  @@index([senderId])
  @@index([recipientId])
  @@index([date])
  @@index([visibility])
  @@index([taskIds])
}

model Delegation {
  id          String         @id @default(auto()) @map("_id") @db.ObjectId
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  delegatorId String         @db.ObjectId
  delegatedId String         @db.ObjectId
  scope       NoteVisibility @default(AI_ENABLED)
  scopes      NoteVisibility[] @default([AI_ENABLED])
  // Relationship labels (Doctor, Tutor, Mentor, ...) — see Role model
  roleIds     String[]       @default([]) @db.ObjectId
  // Mood-data access granted to the delegate (phone assistant + in-app views).
  // Privacy-first default: no mood data unless explicitly granted.
  moodScope   MoodScope      @default(NONE)
  delegator   User           @relation("Delegator", fields: [delegatorId], references: [id], onDelete: Cascade)
  delegated   User           @relation("Delegated", fields: [delegatedId], references: [id], onDelete: Cascade)

  @@unique([delegatorId, delegatedId])
  @@index([delegatorId])
  @@index([delegatedId])
}

// Phone-number delegation (phase 12): grants a caller phone number access to
// the delegator's data during Telnyx phone conversations, at the same
// fine-grained scopes as user Delegations, plus a mood-data access level.
model PhoneDelegation {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Delegator (grants access to THEIR data when this number calls their assistant)
  userId String @db.ObjectId
  user   User   @relation("PhoneDelegations", fields: [userId], references: [id], onDelete: Cascade)

  phoneNumber String  // E.164, normalized (+1...)
  label       String? // optional display name ("Mom") for greetings/transcripts
  scopes      NoteVisibility[] @default([PUBLIC])
  scope       NoteVisibility @default(PUBLIC)
  // Mood-data access granted to this number during phone conversations.
  // Privacy-first default: no mood data unless explicitly granted.
  moodScope   MoodScope @default(NONE)

  @@unique([userId, phoneNumber])
  @@index([phoneNumber])
}

// AI-generated professional summary of a user's PUBLIC profile + recent public
// notes. Regenerated at most every 30 days (getPublicProfileSummary).
model PublicProfileSummary {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @unique @db.ObjectId
  summary     String
  generatedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([generatedAt])
}

model Role {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  key       String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Comment {
  id         String     @id @default(auto()) @map("_id") @db.ObjectId
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  content    String
  visibility Visibility @default(PRIVATE)
  // Relations
  userId     String     @db.ObjectId
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  noteId     String?    @db.ObjectId
  note       Note?      @relation(fields: [noteId], references: [id], onDelete: Cascade)
  templateId String?    @db.ObjectId
  template   Template?  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  listId     String?    @db.ObjectId
  list       List?      @relation(fields: [listId], references: [id], onDelete: Cascade)
  profileId  String?    @db.ObjectId
  profile    Profile?   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  eventId    String?    @db.ObjectId
  event      Event?     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  lifeEventId String?   @db.ObjectId
  lifeEvent  LifeEvent? @relation(fields: [lifeEventId], references: [id], onDelete: Cascade)
  likes      Like[]
  // Reference arrays
  noteIds    String[]   @default([]) @db.ObjectId

  @@index([userId])
  @@index([noteId])
}

model Like {
  id         String     @id @default(auto()) @map("_id") @db.ObjectId
  createdAt  DateTime   @default(now())
  entityType String
  entityId   String     @db.ObjectId
  visibility Visibility @default(PRIVATE)
  // Relations
  userId     String     @db.ObjectId
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  noteId     String?    @db.ObjectId
  note       Note?      @relation(fields: [noteId], references: [id], onDelete: Cascade)
  templateId String?    @db.ObjectId
  template   Template?  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  commentId  String?    @db.ObjectId
  comment    Comment?   @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, entityType, entityId])
  @@index([entityType, entityId])
}

model Template {
  id          String         @id @default(auto()) @map("_id") @db.ObjectId
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  name        String?
  role        String?
  visibility  Visibility     @default(PRIVATE)
  // Embedded data
  tasks       EmbeddedTask[]
  users       UserReference[]
  clonedBy    String[]       @default([]) @db.ObjectId
  // Relations
  lists       List[]
  comments    Comment[]
  likes       Like[]
  // Reference arrays
  noteIds     String[]       @default([]) @db.ObjectId
  documentIds String[]       @default([]) @db.ObjectId

  @@index([visibility])
}

model List {
  id                   String             @id @default(auto()) @map("_id") @db.ObjectId
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  name                 String?
  role                 String?
  visibility           Visibility         @default(PRIVATE)
  // Embedded data
  categories           Category[]
  area                 Areas?
  users                UserReference[]
  history              ListHistoryEntry[]
  // Budget (simplified)
  budget               Float?             // Fiat budget
  budgetType           String?            // "FIAT" | "PERCENT" (percent of budget sources)
  budgetPercent        Float?             // 0-100 when budgetType is PERCENT
  budgetSourceIds      String[]           @default([]) @db.ObjectId  // User Budget records this list draws from
  budgetSources        Budget[]           @relation("ListBudgetSources", fields: [budgetSourceIds], references: [id])
  // Public profile
  bio                  String?
  profilePhoto         String?
  links                Json?              // [{ label, url }]
  publicUrl            String?            @unique // Unique public slug
  publicTagline        String?
  publicVisible        Boolean            @default(false)  // explicit publish switch, independent of `visibility`
  coverDocumentId      String?            @db.ObjectId
  location             Json?              // org/venue location for the job board
  jobBoardEnabled      Boolean            @default(false)
  // Status fields
  ticker               String?
  progress             String?
  completion           Float?
  dueDate              String?
  // Legacy snapshot of removed fields (preserved for data integrity)
  legacy               Json?
  // Migration tracking
  migrationMetadata    Json?
  // Relations
  templateId           String?            @db.ObjectId
  template             Template?          @relation(fields: [templateId], references: [id])
  walletId             String?            @db.ObjectId
  wallet               Wallet?            @relation(fields: [walletId], references: [id])
  projectId            String?            @db.ObjectId   // optional: this list is one of a project's job boards
  project              Project?           @relation(fields: [projectId], references: [id])
  // Phase 7: polymorphic owner (USER | ORG)
  ownerType            String             @default("USER")
  orgId                String?            @db.ObjectId
  org                  Organization?      @relation(fields: [orgId], references: [id])
  tasks                Task[]
  jobs                 Job[]
  comments             Comment[]
  requests             ListRequest[]
  // Reference arrays
  taskIds              String[]           @default([]) @db.ObjectId
  noteIds              String[]           @default([]) @db.ObjectId
  documentIds          String[]           @default([]) @db.ObjectId
  eventIds             String[]           @default([]) @db.ObjectId
  events               Event[]            @relation("EventLists", fields: [eventIds], references: [id])
  raisedTransactionIds String[]           @default([]) @db.ObjectId
  raisedTransactions   Transaction[]      @relation("ListRaised", fields: [raisedTransactionIds], references: [id])

  @@index([visibility])
  @@index([templateId])
  @@index([publicVisible])
  @@index([projectId])
}

model ListRequest {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  status    String   @default("PENDING")   // PENDING | ACCEPTED | DECLINED
  message   String?
  listId    String   @db.ObjectId
  list      List     @relation(fields: [listId], references: [id], onDelete: Cascade)
  userId    String   @db.ObjectId
  user      User     @relation("ListRequests", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([listId, userId])
  @@index([listId])
}

model Task {
  id                   String              @id @default(auto()) @map("_id") @db.ObjectId
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  name                 String
  categories           Category[]
  area                 Areas
  status               TaskStatus          @default(OPEN)
  // Recurrence (RRULE - RFC 5545 string, e.g. "FREQ=WEEKLY;INTERVAL=1;BYDAY=TH"; null = one-off task)
  rrule                String?
  dtstart              String?             // YYYY-MM-DD start date
  // Materialized recurrence chain: root task id for occurrence rows created at completion
  recurringTaskId      String?             @db.ObjectId
  // Progress fields
  times                Int?                // Target completions per occurrence (counter)
  localeKey            String?
  completedOn          String?
  dueDate              DateTime?
  // Budget/premium (simplified)
  premiumType          String?             // "FIAT" | "PERCENT" (percent of list budget)
  premium              Float?              // Premium value: fiat amount, or percent (0-100) when premiumType is PERCENT
  // Job post (active when visibility = PUBLIC and the list has jobBoardEnabled)
  jobDescription       String?             // long form, markdown + inline link previews
  requirements         String?
  openings             Int?                @default(1)
  applyBy              String?             // YYYY-MM-DD
  // Geolocation
  location             Json?               // { lat, lng, placeId?, name?, address? }
  visibility           Visibility?
  quality              Int?
  redacted             Boolean?            @default(false)
  // Legacy snapshot of removed fields (preserved for data integrity)
  legacy               Json?
  // Embedded references
  persons              PersonReference[]
  things               ThingReference[]
  events               EventReference[]
  notes                NoteReference[]
  // Relations
  listId               String?             @db.ObjectId
  list                 List?               @relation(fields: [listId], references: [id], onDelete: Cascade)
  jobs                 Job[]
  documentIds          String[]            @default([]) @db.ObjectId
  documents            Document[]          @relation("TaskDocuments", fields: [documentIds], references: [id])
  candidateIds         String[]            @default([]) @db.ObjectId
  candidates           User[]              @relation("TaskCandidates", fields: [candidateIds], references: [id])
  applications         TaskApplication[]
  raisedTransactionIds String[]            @default([]) @db.ObjectId
  raisedTransactions   Transaction[]       @relation("TaskRaised", fields: [raisedTransactionIds], references: [id])

  @@index([listId])
  @@index([status])
  @@index([listId, status])
  @@index([recurringTaskId])
}

model TaskApplication {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  status      String   @default("PENDING")  // PENDING | SHORTLISTED | ACCEPTED | DECLINED | WITHDRAWN
  message     String?
  documentIds String[] @default([]) @db.ObjectId   // CV / portfolio via Phase 4
  taskId      String   @db.ObjectId
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  listId      String   @db.ObjectId
  userId      String   @db.ObjectId
  user        User     @relation("TaskApplications", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@index([listId, status])
}

model Job {
  id               String      @id @default(auto()) @map("_id") @db.ObjectId
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  status           JobStatus   @default(REQUESTED)
  // The date this job applies to (YYYY-MM-DD format)
  // Allows same task to have different completion states on different days
  occurrenceDate   String?
  // Justification for requesting the job (required for collaborators, optional for owners/managers)
  justification    String?
  // Geolocation (auto-extracted from evidence EXIF when available)
  location         Json?
  // Review fields
  selfReview       Float?
  peerReview       Float?
  managerReview    Float?
  // Financial fields
  earnings         Float?      // Earnings from task budget
  premium          Float?      // Premium from task premium (was prize)
  totalGains       Float?      // Total gains (earnings + premium)
  // Invoice - captures task values at job initiation (IN_PROGRESS)
  invoice          JobInvoice?
  // Relations
  workerId         String      @db.ObjectId
  worker           User        @relation("JobWorker", fields: [workerId], references: [id], onDelete: Cascade)
  taskId           String      @db.ObjectId
  task             Task        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  listId           String      @db.ObjectId
  list             List        @relation(fields: [listId], references: [id], onDelete: Cascade)
  requesterNoteIds String[]    @default([]) @db.ObjectId
  requesterNotes   Note[]      @relation("JobRequesterNotes", fields: [requesterNoteIds], references: [id])
  reviewerIds      String[]    @default([]) @db.ObjectId
  reviewers        User[]      @relation("JobReviewers", fields: [reviewerIds], references: [id])
  reviewersNoteIds String[]    @default([]) @db.ObjectId
  reviewersNotes   Note[]      @relation("JobReviewersNotes", fields: [reviewersNoteIds], references: [id])
  // Evidence attachments
  documentIds      String[]    @default([]) @db.ObjectId
  documents        Document[]  @relation("JobDocuments", fields: [documentIds], references: [id])

  @@index([workerId])
  @@index([taskId])
  @@index([listId])
  @@index([status])
  @@index([occurrenceDate])
  @@index([taskId, occurrenceDate])
  @@index([workerId, occurrenceDate])
  @@index([listId, occurrenceDate])
}

