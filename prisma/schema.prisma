// =============================================================================
// PRISMA SCHEMA - MongoDB
// =============================================================================
// Organization: Generator/Datasource → Enums → Types → Models
// =============================================================================

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// =============================================================================
// ENUMS
// =============================================================================

enum Areas {
  self
  home
  social
  work
}

enum BudgetEntryType {
  LIST_DEFAULT  // Default budget associated with a specific list
  EXTERNAL      // External budget that can be shared/reused
}

enum Category {
  body
  spirituality
  fun
  extra
  clean
  affection
  maintenance
  community
  growth
  work
  mind
  spirit
  social
  home
  custom
  event
}

enum CurrencyCode {
  USD
  EUR
  JPY
  GBP
  CNY
  AUD
  CAD
  CHF
  HKD
  BRL
  SEK
  NZD
  MXN
  SGD
  NOK
  KRW
  TRY
  INR
  RUB
  ZAR
  PLN
  CZK
  HUF
  RON
  BGN
  DKK
  ISK
  RSD
  BAM
  MKD
  ALL
  MDL
  UAH
  BYN
  GEL
  AMD
  AZN
}

enum JobStatus {
  REQUESTED
  IN_PROGRESS
  SUBMITTED
  VALIDATING
  ACCEPTED
  REJECTED
  CANCELLED
}

enum NoteVisibility {
  PRIVATE
  FRIENDS
  CLOSE_FRIENDS
  PUBLIC
  AI_ENABLED
}

enum RecurrenceFrequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
  NONE
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  STEADY
  READY
  DONE
  IGNORED
  SKIPPED
  COMPLETED
}

enum UserRole {
  OWNER
  MANAGER
  COLLABORATOR
  FOLLOWER
}

enum Visibility {
  PUBLIC
  PRIVATE
  FRIENDS
  CLOSE_FRIENDS
  HIDDEN
}

// =============================================================================
// EMBEDDED TYPES
// =============================================================================

type Completer {
  id          String    @db.ObjectId
  earnings    Float?
  premium     Float?
  time        Int
  completedAt DateTime
}

type Consents {
  doInvestDemo DoInvestDemoConsent?
}

type Currency {
  code   CurrencyCode?
  symbol String?
}

type DayVisibility {
  lists    Boolean
  mood     Boolean
  ticker   Boolean
  analysis Boolean
}

type DoInvestDemoConsent {
  consentedOn     DateTime
  consentQuestion String
}

type DocumentReference {
  id       String
  fileName String
  fileUrl  String
}

type EmbeddedTask {
  id              String?
  name            String
  cadence         String? //to-do replace with recurrence   
  categories      Category[]
  area            Areas
  status          String
  recurrence      RecurrenceRule?
  nextOccurrence  DateTime?
  lastOccurrence  DateTime?
  firstOccurrence DateTime?
  times           Int?
  count           Int?
  localeKey       String?
  persons         PersonReference[]
  things          ThingReference[]
  events          EventReference[]
  notes           NoteReference[]
  documents       DocumentReference[]
  createdAt       String?
  completedOn     String?
  dueDate         DateTime?
  budget          Float?
  visibility      Visibility?
  quality         Int?
  redacted        Boolean?          @default(false)
  templateId      String?           // Optional reference to original template
}

type EventReference {
  id   String
  name String
}

type ListHistoryEntry {
  year      Int
  date      String // YYYY-MM-DD format
  operation String // e.g., 'completed', 'requested-validation'
  username  String?
  userId    String @db.ObjectId
}

type ListProductivity {
  totalTasks     Int
  completedTasks Int
  percentage     Float
}

type Mood {
  gratitude  Float
  optimism   Float
  restedness Float
  tolerance  Float
  selfEsteem Float
  trust      Float
}

type NoteReference {
  id      String
  content String
}

type PersonReference {
  id   String
  name String
}

type ProfileChartField {
  name       String?
  value      Json?
  visibility Boolean
}

type ProfileData {
  username       ProfileField?
  firstName      ProfileField?
  lastName       ProfileField?
  bio            ProfileField?
  profilePicture ProfileField?
  charts         ProfileChartField?
}

type ProfileField {
  name       String?
  value      String?
  visibility Boolean
}

type RecurrenceRule {
  frequency       RecurrenceFrequency
  interval        Int                 @default(1)
  byWeekday       Int[]
  byMonthDay      Int[]
  byMonth         Int[]
  endDate         DateTime?
  occurrenceCount Int?
}

type Settings {
  currency Currency?
  speed    Float?
}

type ThingReference {
  id   String
  name String
}

type AllocationType {
  nominal Float?   // Nominal (currency) amount
  percent Float?   // Percentage value (0-100)
}

type EntityBudgetAllocation {
  budget  AllocationType?  // Budget allocation for this entity
  premium AllocationType?  // Premium allocation for this entity
}

type EntityAllocationsType {
  entityId      String?                 // Entity ID (taskId, areaId, categoryId, etc.)
  entityType    String?                 // Entity type: "tasks", "lists", "projects"
  entitySubtype String?                 // Entity subtype: "area", "categories", "notes", or any string
  allocation    EntityBudgetAllocation? // Allocation for this entity
}

type BudgetDistribution {
  areas      EntityAllocationsType[]  // Area allocations (budget + premium)
  categories EntityAllocationsType[]  // Category allocations (budget + premium)
  tasks      EntityAllocationsType[]  // Per-task allocations (budget + premium)
}

type Ticker {
  listId   String?
  taskId   String?
  earnings Float?
  premium  Float?
}

type UserReference {
  userId String   @db.ObjectId
  role   UserRole
}

type JobInvoice {
  quote    Float?  // Original task earnings at job initiation
  premium  Float?  // Premium value at job initiation
  exposure Float?  // totalGains value at job initiation
}

// =============================================================================
// MODELS
// =============================================================================

model User {
  id                 String    @id @default(auto()) @map("_id") @db.ObjectId
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  userId             String?   @unique
  email              String?
  lastLogin          DateTime?
  settings           Settings?
  consents           Consents?
  // Financial fields
  usedBudget         Float?    @default(0)
  remainingBudget    Float?    @default(100)
  stash              Float?    @default(0)
  profit             Float?    @default(0)
  equity             Float?    @default(0)
  availableBalance   Float?    @default(0)
  withdrawn          Float?    @default(0)
  totalGains         Float?    @default(0)
  // Relations
  persons            Person[]
  things             Thing[]
  events             Event[]
  notes              Note[]
  comments           Comment[]
  likes              Like[]
  profiles           Profile[]
  charts             Chart[]
  budgets            Budget[]
  days               Day[]
  offers             Offer[]
  tokens             Token[]
  transactions       Transaction[]
  wallets            Wallet[]
  workerJobs         Job[]     @relation("JobWorker")
  // Friend relations (self-referential many-to-many)
  friends            String[]  @default([]) @db.ObjectId
  friendUsers        User[]    @relation("UserFriends", fields: [friends], references: [id])
  friendOfIds        String[]  @default([]) @db.ObjectId
  friendOf           User[]    @relation("UserFriends", fields: [friendOfIds], references: [id])
  closeFriends       String[]  @default([]) @db.ObjectId
  closeFriendUsers   User[]    @relation("UserCloseFriends", fields: [closeFriends], references: [id])
  closeFriendOfIds   String[]  @default([]) @db.ObjectId
  closeFriendOf      User[]    @relation("UserCloseFriends", fields: [closeFriendOfIds], references: [id])
  friendRequests     String[]  @default([]) @db.ObjectId
  friendRequestUsers User[]    @relation("UserFriendRequests", fields: [friendRequests], references: [id])
  friendRequestOfIds String[]  @default([]) @db.ObjectId
  friendRequestOf    User[]    @relation("UserFriendRequests", fields: [friendRequestOfIds], references: [id])
  // Task/Job relations
  candidateTaskIds   String[]  @default([]) @db.ObjectId
  candidateTasks     Task[]    @relation("TaskCandidates", fields: [candidateTaskIds], references: [id])
  reviewerJobIds     String[]  @default([]) @db.ObjectId
  reviewerJobs       Job[]     @relation("JobReviewers", fields: [reviewerJobIds], references: [id])
}

model Profile {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  userId      String       @unique @db.ObjectId
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  username    String?      @unique
  visibility  Visibility   @default(PUBLIC)
  data        ProfileData?
  // Reference arrays
  personIds   String[]     @default([]) @db.ObjectId
  persons     Person[]     @relation("PersonProfiles", fields: [personIds], references: [id])
  noteIds     String[]     @default([]) @db.ObjectId
  documentIds String[]     @default([]) @db.ObjectId
  // Back relations
  comments    Comment[]
  charts      Chart[]
  days        Day[]
}

model Day {
  id              String         @id @default(auto()) @map("_id") @db.ObjectId
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  date            String?
  week            Int?
  month           Int?
  quarter         Int?
  semester        Int?
  // Embedded data
  tasks           EmbeddedTask[]
  mood            Mood?
  ticker          Ticker[]
  analysis        Json?
  productivity    Json?
  fieldVisibility DayVisibility?
  // Calculated fields
  average         Float?
  progress        Float?
  balance         Float?
  stash           Float?
  equity          Float?
  withdrawn       Float?
  // Visibility
  visibility      Visibility     @default(PRIVATE)
  // Reference arrays
  personIds       String[]       @default([]) @db.ObjectId
  thingIds        String[]       @default([]) @db.ObjectId
  eventIds        String[]       @default([]) @db.ObjectId
  chartIds        String[]       @default([]) @db.ObjectId
  noteIds         String[]       @default([]) @db.ObjectId
  commentIds      String[]       @default([]) @db.ObjectId
  likeIds         String[]       @default([]) @db.ObjectId
  // Relations
  userId          String         @db.ObjectId
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  profileId       String?        @db.ObjectId
  profile         Profile?       @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
}

model Note {
  id             String         @id @default(auto()) @map("_id") @db.ObjectId
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  content        String
  date           String?
  visibility     NoteVisibility @default(PRIVATE)
  // Relations
  userId         String         @db.ObjectId
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments       Comment[]
  likes          Like[]
  // Reference arrays
  personIds      String[]       @default([]) @db.ObjectId
  thingIds       String[]       @default([]) @db.ObjectId
  eventIds       String[]       @default([]) @db.ObjectId
  profileIds     String[]       @default([]) @db.ObjectId
  templateIds    String[]       @default([]) @db.ObjectId
  listIds         String[]       @default([]) @db.ObjectId
  documentIds     String[]       @default([]) @db.ObjectId
  chartIds        String[]       @default([]) @db.ObjectId
  requesterJobIds String[]       @default([]) @db.ObjectId
  requesterJobs   Job[]          @relation("JobRequesterNotes", fields: [requesterJobIds], references: [id])
  reviewerJobIds  String[]       @default([]) @db.ObjectId
  reviewerJobs    Job[]          @relation("JobReviewersNotes", fields: [reviewerJobIds], references: [id])

  @@index([userId])
  @@index([date])
  @@index([visibility])
}

model Comment {
  id         String     @id @default(auto()) @map("_id") @db.ObjectId
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  content    String
  visibility Visibility @default(PRIVATE)
  // Relations
  userId     String     @db.ObjectId
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  noteId     String?    @db.ObjectId
  note       Note?      @relation(fields: [noteId], references: [id], onDelete: Cascade)
  templateId String?    @db.ObjectId
  template   Template?  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  listId     String?    @db.ObjectId
  list       List?      @relation(fields: [listId], references: [id], onDelete: Cascade)
  profileId  String?    @db.ObjectId
  profile    Profile?   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  eventId    String?    @db.ObjectId
  event      Event?     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  likes      Like[]
  // Reference arrays
  noteIds    String[]   @default([]) @db.ObjectId

  @@index([userId])
  @@index([noteId])
}

model Like {
  id         String     @id @default(auto()) @map("_id") @db.ObjectId
  createdAt  DateTime   @default(now())
  entityType String
  entityId   String     @db.ObjectId
  visibility Visibility @default(PRIVATE)
  // Relations
  userId     String     @db.ObjectId
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  noteId     String?    @db.ObjectId
  note       Note?      @relation(fields: [noteId], references: [id], onDelete: Cascade)
  templateId String?    @db.ObjectId
  template   Template?  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  commentId  String?    @db.ObjectId
  comment    Comment?   @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, entityType, entityId])
  @@index([entityType, entityId])
}

model Template {
  id          String         @id @default(auto()) @map("_id") @db.ObjectId
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  name        String?
  role        String?
  visibility  Visibility     @default(PRIVATE)
  // Embedded data
  tasks       EmbeddedTask[]
  users       UserReference[]
  clonedBy    String[]       @default([]) @db.ObjectId
  // Relations
  lists       List[]
  comments    Comment[]
  likes       Like[]
  // Reference arrays
  noteIds     String[]       @default([]) @db.ObjectId
  documentIds String[]       @default([]) @db.ObjectId

  @@index([visibility])
}

model List {
  id                   String             @id @default(auto()) @map("_id") @db.ObjectId
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  name                 String?
  role                 String?
  visibility           Visibility         @default(PRIVATE)
  // Embedded data
  categories           Category[]
  area                 Areas?
  users                UserReference[]
  templateTasks        EmbeddedTask[]
  history              ListHistoryEntry[]
  // Budget fields (legacy - will be deprecated)
  budget               Float?
  remainingBudget      String?
  premiumPercentage    Float?             @default(0)
  budgetDistribution   BudgetDistribution?  // Budget allocation across areas/categories/tasks
  // Budget relationships (new approach)
  listBudgetId         String?            @db.ObjectId  // 1:1 with LIST_DEFAULT budget
  listBudget           Budget?            @relation("ListDefaultBudget", fields: [listBudgetId], references: [id])
  relatedBudgetIds     String[]           @default([]) @db.ObjectId  // 1:Many with EXTERNAL budgets
  relatedBudgets       Budget[]           @relation("ListRelatedBudgets", fields: [relatedBudgetIds], references: [id])
  // Status fields
  publicUrl            String?
  ticker               String?
  progress             String?
  completion           Float?
  dueDate              String?
  // Migration tracking
  migrationMetadata    Json?
  // Relations
  templateId           String?            @db.ObjectId
  template             Template?          @relation(fields: [templateId], references: [id])
  walletId             String?            @db.ObjectId
  wallet               Wallet?            @relation(fields: [walletId], references: [id])
  tasks                Task[]
  jobs                 Job[]
  comments             Comment[]
  // Reference arrays
  taskIds              String[]           @default([]) @db.ObjectId
  noteIds              String[]           @default([]) @db.ObjectId
  documentIds          String[]           @default([]) @db.ObjectId
  raisedTransactionIds String[]           @default([]) @db.ObjectId
  raisedTransactions   Transaction[]      @relation("ListRaised", fields: [raisedTransactionIds], references: [id])

  @@index([visibility])
  @@index([templateId])
}

model Task {
  id                   String              @id @default(auto()) @map("_id") @db.ObjectId
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  name                 String
  categories           Category[]
  area                 Areas
  status               TaskStatus          @default(OPEN)
  // Recurrence fields
  recurrence           RecurrenceRule?
  nextOccurrence       DateTime?
  lastOccurrence       DateTime?
  firstOccurrence      DateTime?
  // Progress fields
  times                Int?
  count                Int?
  localeKey            String?
  completedOn          String?
  dueDate              DateTime?
  budget               Float?
  earnings             Float?              // Task earnings (was profit/budget consumption)
  premium              Float?              // Premium allocation (was prize)
  totalGains           Float?              // Total potential gains for this task
  visibility           Visibility?
  quality              Int?
  redacted             Boolean?            @default(false)
  // Embedded references
  persons              PersonReference[]
  things               ThingReference[]
  events               EventReference[]
  notes                NoteReference[]
  documents            DocumentReference[]
  // Relations
  listId               String?             @db.ObjectId
  list                 List?               @relation(fields: [listId], references: [id], onDelete: Cascade)
  jobs                 Job[]
  candidateIds         String[]            @default([]) @db.ObjectId
  candidates           User[]              @relation("TaskCandidates", fields: [candidateIds], references: [id])
  raisedTransactionIds String[]            @default([]) @db.ObjectId
  raisedTransactions   Transaction[]       @relation("TaskRaised", fields: [raisedTransactionIds], references: [id])

  @@index([listId])
  @@index([status])
}

model Job {
  id               String      @id @default(auto()) @map("_id") @db.ObjectId
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  status           JobStatus   @default(REQUESTED)
  // The date this job applies to (YYYY-MM-DD format)
  // Allows same task to have different completion states on different days
  occurrenceDate   String?
  // Review fields
  selfReview       Float?
  peerReview       Float?
  managerReview    Float?
  // Financial fields
  earnings         Float?      // Earnings from task budget
  premium          Float?      // Premium from task premium (was prize)
  totalGains       Float?      // Total gains (earnings + premium)
  // Invoice - captures task values at job initiation (IN_PROGRESS)
  invoice          JobInvoice?
  // Relations
  workerId         String      @db.ObjectId
  worker           User        @relation("JobWorker", fields: [workerId], references: [id], onDelete: Cascade)
  taskId           String      @db.ObjectId
  task             Task        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  listId           String      @db.ObjectId
  list             List        @relation(fields: [listId], references: [id], onDelete: Cascade)
  requesterNoteIds String[]    @default([]) @db.ObjectId
  requesterNotes   Note[]      @relation("JobRequesterNotes", fields: [requesterNoteIds], references: [id])
  reviewerIds      String[]    @default([]) @db.ObjectId
  reviewers        User[]      @relation("JobReviewers", fields: [reviewerIds], references: [id])
  reviewersNoteIds String[]    @default([]) @db.ObjectId
  reviewersNotes   Note[]      @relation("JobReviewersNotes", fields: [reviewersNoteIds], references: [id])

  @@index([workerId])
  @@index([taskId])
  @@index([listId])
  @@index([status])
  @@index([occurrenceDate])
  @@index([taskId, occurrenceDate])
  @@index([workerId, occurrenceDate])
}

model Person {
  id          String     @id @default(auto()) @map("_id") @db.ObjectId
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  name        String
  quality     Int?
  visibility  Visibility @default(PRIVATE)
  // Relations
  userId      String     @db.ObjectId
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  profileIds  String[]   @default([]) @db.ObjectId
  profiles    Profile[]  @relation("PersonProfiles", fields: [profileIds], references: [id])
  // Reference arrays
  noteIds     String[]   @default([]) @db.ObjectId
  documentIds String[]   @default([]) @db.ObjectId

  @@index([userId])
}

model Thing {
  id          String     @id @default(auto()) @map("_id") @db.ObjectId
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  name        String
  quality     Int?
  visibility  Visibility @default(PRIVATE)
  // Relations
  userId      String     @db.ObjectId
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Reference arrays
  noteIds     String[]   @default([]) @db.ObjectId
  documentIds String[]   @default([]) @db.ObjectId

  @@index([userId])
}

model Event {
  id          String     @id @default(auto()) @map("_id") @db.ObjectId
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  name        String
  quality     Int?
  visibility  Visibility @default(PRIVATE)
  // Relations
  userId      String     @db.ObjectId
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments    Comment[]
  // Reference arrays
  noteIds     String[]   @default([]) @db.ObjectId
  documentIds String[]   @default([]) @db.ObjectId

  @@index([userId])
}

model Budget {
  id                String          @id @default(auto()) @map("_id") @db.ObjectId
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  name              String
  description       String?
  type              BudgetEntryType
  totalAmount       Float
  remainingAmount   Float
  // Task allocations - array of entityId to EntityBudgetAllocation mappings
  taskAllocations   EntityAllocationsType[]
  // Relations
  ownerId           String          @db.ObjectId
  owner             User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  // Lists that use this as their default budget (1:1 inverse relation - no array needed)
  defaultForLists   List[]          @relation("ListDefaultBudget")
  // Lists that reference this as a related budget (many-to-many)
  relatedToListIds  String[]        @default([]) @db.ObjectId
  relatedToLists    List[]          @relation("ListRelatedBudgets", fields: [relatedToListIds], references: [id])
  // Wallets that reference this budget (many-to-many)
  walletIds         String[]        @default([]) @db.ObjectId
  wallets           Wallet[]        @relation("BudgetWallets", fields: [walletIds], references: [id])

  @@index([ownerId])
  @@index([type])
}

model Chart {
  id         String     @id @default(auto()) @map("_id") @db.ObjectId
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  name       String?
  type       String?
  data       Json?
  config     Json?
  visibility Visibility @default(PRIVATE)
  // Relations
  userId     String     @db.ObjectId
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  profileId  String?    @db.ObjectId
  profile    Profile?   @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Document {
  id           String          @id @default(auto()) @map("_id") @db.ObjectId
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  fileUrl      String
  fileName     String
  fileSize     Float?
  fileFormat   String?
  fileDuration Float?
  visibility   Visibility      @default(PRIVATE)
  // Embedded data
  users        UserReference[]
  // Reference arrays
  listIds      String[]        @default([]) @db.ObjectId
  templateIds  String[]        @default([]) @db.ObjectId
  noteIds      String[]        @default([]) @db.ObjectId
  thingIds     String[]        @default([]) @db.ObjectId
  eventIds     String[]        @default([]) @db.ObjectId
  personIds    String[]        @default([]) @db.ObjectId
  profileIds   String[]        @default([]) @db.ObjectId
  chartIds     String[]        @default([]) @db.ObjectId
}

model Offer {
  id          String     @id @default(auto()) @map("_id") @db.ObjectId
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  name        String?
  description String?
  price       Float?
  discount    Float?
  visibility  Visibility @default(PRIVATE)
  // Relations
  userId      String     @db.ObjectId
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId   String?    @db.ObjectId
  product     Product?   @relation(fields: [productId], references: [id], onDelete: Cascade)
  // Reference arrays
  noteIds     String[]   @default([]) @db.ObjectId
  documentIds String[]   @default([]) @db.ObjectId

  @@index([userId])
}

model Product {
  id           String          @id @default(auto()) @map("_id") @db.ObjectId
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  name         String
  description  String?
  price        Float?
  goal         Float?
  raised       Float?
  visibility   Visibility      @default(PRIVATE)
  // Embedded data
  users        UserReference[]
  // Relations
  offers       Offer[]
  transactions Transaction[]
  // Reference arrays
  listIds      String[]        @default([]) @db.ObjectId
  noteIds      String[]        @default([]) @db.ObjectId
  documentIds  String[]        @default([]) @db.ObjectId
}

model Token {
  id          String     @id @default(auto()) @map("_id") @db.ObjectId
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  token       String
  type        String?
  expiresAt   DateTime?
  visibility  Visibility @default(PRIVATE)
  // Relations
  userId      String     @db.ObjectId
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Reference arrays
  noteIds     String[]   @default([]) @db.ObjectId
  documentIds String[]   @default([]) @db.ObjectId

  @@index([userId])
  @@index([token])
}

model Transaction {
  id              String     @id @default(auto()) @map("_id") @db.ObjectId
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  amount          Float
  type            String?
  status          String?
  fromAddress     String
  toAddress       String
  visibility      Visibility @default(PRIVATE)
  // Relations
  userId          String     @db.ObjectId
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  walletId        String?    @db.ObjectId
  wallet          Wallet?    @relation(fields: [walletId], references: [id], onDelete: Cascade)
  productId       String?    @db.ObjectId
  product         Product?   @relation(fields: [productId], references: [id], onDelete: Cascade)
  // Reference arrays
  noteIds         String[]   @default([]) @db.ObjectId
  documentIds     String[]   @default([]) @db.ObjectId
  raisedByTaskIds String[]   @default([]) @db.ObjectId
  raisedByTasks   Task[]     @relation("TaskRaised", fields: [raisedByTaskIds], references: [id])
  raisedByListIds String[]   @default([]) @db.ObjectId
  raisedByLists   List[]     @relation("ListRaised", fields: [raisedByListIds], references: [id])

  @@index([userId])
  @@index([walletId])
}

model Wallet {
  id           String        @id @default(auto()) @map("_id") @db.ObjectId
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  name         String?
  address      String?
  visibility   Visibility    @default(PRIVATE)
  // Relations
  userId       String        @db.ObjectId
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  lists        List[]
  // Budget relationships (budgets can associate with multiple wallets)
  budgetIds    String[]      @default([]) @db.ObjectId
  budgets      Budget[]      @relation("BudgetWallets", fields: [budgetIds], references: [id])
  // Reference arrays
  noteIds      String[]      @default([]) @db.ObjectId
  documentIds  String[]      @default([]) @db.ObjectId

  @@index([userId])
  @@index([address])
}
